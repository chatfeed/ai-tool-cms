# Required in production to protect /admin and draft previews.
ADMIN_PASSWORD=change-this-password

# Optional but recommended in production. Falls back to ADMIN_PASSWORD if omitted.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional. Without this key, tool runs use the local mock provider.
OPENAI_API_KEY=

# Optional. Used by sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
